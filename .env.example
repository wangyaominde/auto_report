# WorkLog LLM 配置 —— 复制为 .env 填写，或直接用 GUI 的「设置」页配置
# 预设示例（GUI 设置页可一键切换）：
#   MiniMax    https://api.minimaxi.com/anthropic/v1/messages   (anthropic 格式, MiniMax-M3)
#   OpenAI     https://api.openai.com/v1/chat/completions       (openai 格式, gpt-4o 等)
#   Anthropic  https://api.anthropic.com/v1/messages            (anthropic 格式, claude-sonnet-5 等)
#   Kimi       https://api.moonshot.cn/v1/chat/completions      (openai 格式, kimi-latest)
# 注意：截图视觉分析要求模型支持图片输入

LLM_API_URL=https://api.minimaxi.com/anthropic/v1/messages
LLM_API_KEY=在这里填你的Key
LLM_MODEL=MiniMax-M3
# anthropic | openai；留空则按 URL 是否含 /anthropic/ 自动判断
LLM_API_FORMAT=anthropic
LLM_MAX_TOKENS=8000
# 低温度让报告更贴近素材、少发挥
LLM_TEMPERATURE=0.2
# 每段视觉分析发送的截图张数（越多越细，越费额度）
LLM_MAX_IMAGES=8
# 截图本地保留天数
SCREENSHOT_RETENTION_DAYS=7
